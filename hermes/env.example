# Copier ces lignes dans ~/.hermes/.env sur le serveur et remplir les valeurs.
# NE JAMAIS committer ce fichier une fois rempli.

# ---- Modèle IA : Azure (Microsoft Foundry), voir config.azure.yaml
# Rien à mettre si la VM Azure utilise son identité managée (auth_mode: entra_id).
# Sinon, clé de la ressource (Foundry > Keys and Endpoint) :
# AZURE_FOUNDRY_API_KEY=

# ---- Telegram : canal du propriétaire
TELEGRAM_BOT_TOKEN=            # donné par @BotFather (/newbot)
TELEGRAM_ALLOWED_USERS=        # ID numérique du proprio (via @userinfobot)
TELEGRAM_HOME_CHANNEL=         # même ID : destination des alertes planifiées
AR_OWNER_TELEGRAM_ID=          # même ID : utilisé par ar.py notify / new --send

# ---- Site (Supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # Project Settings > API > service_role

# ---- WhatsApp : répondre aux clients sur le numéro de l'agence
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
WHATSAPP_ALLOW_ALL_USERS=true  # tout client peut écrire ; le skill limite ce que le bot répond

# ---- Email : répondre aux mails reçus
EMAIL_ADDRESS=                 # boîte dédiée, ex. contact@actionreussite.com
EMAIL_PASSWORD=                # mot de passe d'application (Gmail : myaccount.google.com/apppasswords)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_AUTHSERV_ID=mx.google.com
EMAIL_ALLOW_ALL_USERS=true     # répondre à tout expéditeur (clients inconnus)
EMAIL_HOME_ADDRESS=            # email perso du proprio (copie des alertes, optionnel)
